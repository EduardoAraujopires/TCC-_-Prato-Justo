		{
			"name": "2. Fluxo Completo - Usuário 1",
			"item": [
				{
					"name": "U1 - Criar Doação",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var moment = require('moment');",
									"pm.environment.set(\"dataValidade\", moment().add(10, 'days').format('YYYY-MM-DD'));",
									"pm.environment.set(\"dataColeta\", moment().add(1, 'days').format('YYYY-MM-DD'));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"id_doacao_u1\", jsonData.id);",
									"console.log(\"U1 - Doação criada ID: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u1}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"titulo\": \"Cesta Básica Completa - U1\",\n    \"descricao\": \"Cesta básica completa com arroz, feijão, macarrão, óleo, açúcar, café e outros itens essenciais. Todos os produtos estão dentro do prazo de validade.\",\n    \"tipoAlimento\": \"Não Perecível\",\n    \"quantidade\": 5.0,\n    \"unidade\": \"caixas\",\n    \"cidade\": \"São Paulo\",\n    \"endereco\": \"Rua Teste Um, 100\",\n    \"rua\": \"Rua Teste Um\",\n    \"numero\": \"100\",\n    \"cep\": \"01001-000\",\n    \"estado\": \"SP\",\n    \"complemento\": \"Apto 101\",\n    \"dataValidade\": \"{{dataValidade}}\",\n    \"dataColeta\": \"{{dataColeta}}\",\n    \"latitude\": -23.5505,\n    \"longitude\": -46.6333,\n    \"imagem\": \"https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/doacoes",
							"host": ["{{base_url}}"],
							"path": ["doacoes"]
						}
					}
				},
				{
					"name": "U1 - Upload Imagem da Doação",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.imageUrl) {",
									"    console.log(\"U1 - Imagem enviada: \" + jsonData.imageUrl);",
									"} else {",
									"    console.log(\"U1 - Upload de imagem (opcional - pode ser configurado manualmente)\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u1}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "image",
									"type": "file",
									"src": [],
									"description": "Selecione uma imagem (ex: img/frutas.jpg). Se não tiver arquivo, este passo pode ser ignorado pois a imagem já foi adicionada no JSON."
								},
								{
									"key": "doacaoId",
									"value": "{{id_doacao_u1}}",
									"type": "text",
									"description": "ID da doação criada"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/doacoes/upload-image",
							"host": ["{{base_url}}"],
							"path": ["doacoes", "upload-image"]
						},
						"description": "Upload de imagem para a doação. Se não tiver arquivo local, pode pular este passo pois a imagem já foi definida no JSON da doação."
					}
				},
				{
					"name": "U2 - Solicitar Doação de U1",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"id_solicitacao_u1_u2\", jsonData.id);",
									"console.log(\"U2 solicitou doação de U1 - Solicitação ID: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u2}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/doacoes/{{id_doacao_u1}}/solicitar",
							"host": ["{{base_url}}"],
							"path": ["doacoes", "{{id_doacao_u1}}", "solicitar"]
						}
					}
				},
				{
					"name": "U2 - Enviar Mensagem no Chat para U1",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u2}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"destinatarioId\": {{id_u1}},\n    \"conteudo\": \"Olá U1, tenho interesse na sua doação!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/chat/messages",
							"host": ["{{base_url}}"],
							"path": ["api", "chat", "messages"]
						}
					}
				},
				{
					"name": "U1 - Aceitar Solicitação de U2",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"// Capturar IDs do doador e solicitante da solicitação",
									"if (jsonData.doacao && jsonData.doacao.doador) {",
									"    pm.collectionVariables.set(\"id_doador_solicitacao_u1_u2\", jsonData.doacao.doador.id);",
									"}",
									"if (jsonData.solicitante) {",
									"    pm.collectionVariables.set(\"id_solicitante_solicitacao_u1_u2\", jsonData.solicitante.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u1}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/doacoes/solicitacoes/{{id_solicitacao_u1_u2}}/aceitar",
							"host": ["{{base_url}}"],
							"path": ["doacoes", "solicitacoes", "{{id_solicitacao_u1_u2}}", "aceitar"]
						}
					}
				},
				{
					"name": "U1 - Marcar Coletada (Concluir)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u1}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/doacoes/solicitacoes/{{id_solicitacao_u1_u2}}/marcar-coletada",
							"host": ["{{base_url}}"],
							"path": ["doacoes", "solicitacoes", "{{id_solicitacao_u1_u2}}", "marcar-coletada"]
						}
					}
				},
				{
					"name": "U2 - Avaliar U1 (Doador)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u2}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"solicitacaoId\": {{id_solicitacao_u1_u2}},\n    \"avaliadoId\": {{id_doador_solicitacao_u1_u2}},\n    \"nota\": 5,\n    \"comentario\": \"Ótima doação do U1, muito rápido e organizado!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/avaliacoes-solicitacao",
							"host": ["{{base_url}}"],
							"path": ["avaliacoes-solicitacao"]
						}
					}
				},
				{
					"name": "U1 - Avaliar U2 (Solicitante)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token_u1}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"solicitacaoId\": {{id_solicitacao_u1_u2}},\n    \"avaliadoId\": {{id_solicitante_solicitacao_u1_u2}},\n    \"nota\": 5,\n    \"comentario\": \"U2 foi pontual e educado!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/avaliacoes-solicitacao",
