package application;

import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

import entities.Produto;

public class Progam {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		List<Produto> list  = new ArrayList<>();
		
		System.out.println("Digite o caminho da pasta: ");
		String sourceFileStr = sc.nextLine();
		
		
		File sourceFile = new File(sourceFileStr);
		String sourceFolderStr = sourceFile.getParent();
		
		boolean sucess = new File(sourceFolderStr + "\\out").mkdir();
	
		String targeFileStr = sourceFileStr + "\\out\\summary.csv";
		
		try(BufferedReader br = new BufferedReader(new FileReader(sourceFileStr))){
			
			String itemcsv = br.readLine();
			while(itemcsv != null) {
				
				String[] fields = itemcsv.split(",");
				String name = fields[0];
				double price = Double.parseDouble(fields[1]);
				int quantity = Integer.parseInt(fields[2]);
				
				list.add(new Produto(name, price, quantity));
				
				itemcsv = br.readLine();
				
			}
			try (BufferedWriter bw = new BufferedWriter(new FileWriter(targeFileStr))){
				
				for (Produto item: list) {
					bw.write(item.getName() + "," + String.format("%.2f", item.soma()));
					bw.newLine();
				}
				System.out.println(targeFileStr + "CREATED!");
				
			}catch(IOException e) {
				System.out.println(e.getMessage());
			}
		}catch(IOException e){
			System.out.println(e.getMessage());
		}
		
		
		
		sc.close();
	}

}
