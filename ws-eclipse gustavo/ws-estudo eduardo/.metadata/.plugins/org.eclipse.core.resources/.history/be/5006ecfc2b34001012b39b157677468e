package laco_para;

import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n =sc.nextInt();
		int d=0;
		int f=0;
		for (int i = 0; i < n; i++) {
			int x =sc.nextInt();
			if (x <10 && x <=20) {
				d+=1;
			}else {
		     f+=1;
			}
		}
		
		System.out.println(d+"in");
		System.out.println(f+"out");
		
		sc.close();
	}
}