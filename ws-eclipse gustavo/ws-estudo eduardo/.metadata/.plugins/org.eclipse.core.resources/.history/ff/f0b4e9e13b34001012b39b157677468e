		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		char resp = 's';
		while (resp != 'n' ) {
		int n = sc.nextInt();
		for (int i = 1; i <=n; i++) {
		      int p = i;
		      int s= i * i;
		      int t = i * i *i;
		      System.out.printf("%d  %d  %d%n",p,s,t);
		    }
		System.out.println("deseja fazer outro calculo <s/n>");
		  resp = sc.next();
		   sc.close();
		}
	}			
}	