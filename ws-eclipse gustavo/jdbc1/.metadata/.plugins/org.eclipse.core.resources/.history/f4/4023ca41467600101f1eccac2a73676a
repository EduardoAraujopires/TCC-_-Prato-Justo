package model.entities;

public class Department2 {
	
	private String name;
	private Integer Id;
	
	public Department2() {
	}

	public Department2(String name, Integer id) {
		this.name = name;
		Id = id;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public Integer getId() {
		return Id;
	}

	public void setId(Integer id) {
		Id = id;
	}
	
	
}
