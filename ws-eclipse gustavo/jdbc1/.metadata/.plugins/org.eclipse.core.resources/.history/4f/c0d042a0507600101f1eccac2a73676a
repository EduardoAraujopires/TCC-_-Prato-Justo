	public Department findById(Integer id) {
		PreparedStatement st = null;
		ResultSet rs = null;
		
		try {
			st = conn.prepareStatement("SELECT * FROM departmet WHERE Id = ? ");
			
			st.setInt(1, id);
			rs = st.executeQuery();
