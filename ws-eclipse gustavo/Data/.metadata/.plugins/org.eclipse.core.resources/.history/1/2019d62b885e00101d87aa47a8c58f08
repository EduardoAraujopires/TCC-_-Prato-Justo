		Scanner sc = new Scanner(System.in);

		DateTimeFormatter format = DateTimeFormatter.ofPattern("HH:mm");
		
		System.out.print("Digite o horário de início: ");
		String HoraInicio = sc.nextLine();
		LocalDateTime horainicio = LocalDateTime.parse(HoraInicio,format);
		
		System.out.print("Digite o Horário de termino: ");
		String HoraFim = sc.nextLine();
		LocalDateTime fim = LocalDateTime.parse(HoraFim,format);
		
		Duration duracao = Duration.between(horainicio, fim);
		
		double Horas = duracao.toHours();
		double Minutos = duracao.toMinutes();
		
		System.out.println("Duração do evento: "+ Horas+ " Horas e "+Minutos+" Minutos");
		
		
		
		
