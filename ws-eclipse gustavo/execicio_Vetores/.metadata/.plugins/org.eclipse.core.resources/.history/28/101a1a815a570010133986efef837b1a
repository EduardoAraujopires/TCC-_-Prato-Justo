package application;

import java.util.Scanner;

public class Progam {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("Quantas pessoas voce vai digitar? ");
		int n = sc.nextInt();
		String[] nome = new String[n];
		int[] idade = new int[n];
		int maiorIdade = 0;
		int posicaomaior = 0;
		for(int i = 0; i < n; i++) {
			System.out.print("Dados da "+(i + 1)+ "a pessoa:");
			System.out.print("Nome: ");
			sc.nextLine();
			nome[i] = sc.nextLine();
			System.out.print("Idade: ");
			idade[i] = sc.nextInt();
		}
	
		for(int i = 0; i < n; i++) {
			if(idade[i] > maiorIdade) {
				maiorIdade = idade[i];
				posicaomaior = i;
			}
		}
	
		System.out.printf("Pessoa mais velha: ",nome[posicaomaior]);
	
	
	
	
	sc.close();
	
	}

}
