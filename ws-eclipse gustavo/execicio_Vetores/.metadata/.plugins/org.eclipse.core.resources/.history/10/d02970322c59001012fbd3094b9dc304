package application;

import java.util.ArrayList;
import java.util.Scanner;

public class Progam {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		ArrayList <String> nomes = new ArrayList <>();
		System.out.println("Digite o nome de 5 pessoas: ");
		
		for (int i = 0; i < 5; i++) {
			System.out.println("Nome "+(i+1)+": ");
			String nome = sc.next();
			nomes.add(nome);
		}
		
		System.out.print("Digite um nome nome para buscar: ");
		String buscaNome = sc.next();
		
		
		if(nomes.contains(buscaNome)) {
			System.out.println("O nome "+"'"+ buscaNome +"'"+" foi encontrado na lista.");
		}
		
		sc.close(); 
	}

}
