            <div class="container">
                <div class="cta-content-premium" data-reveal>
                    <div class="cta-badge-premium">
                        <i class="fas fa-hand-holding-heart"></i>
                        Sua Ação Importa
                    </div>
                    
                    <h2>Pronto para <span class="highlight-text">Fazer a Diferença</span>?</h2>
                    
