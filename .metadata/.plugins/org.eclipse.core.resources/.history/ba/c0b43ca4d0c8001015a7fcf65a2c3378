document.addEventListener('DOMContentLoaded', function() {
	// Inicializar todas as funcionalidades
	initAnimations();
	initTimeline();
	initFAQ();
	initCounters();
	initSmoothScroll();
	initAuthCheck();

	console.log('🚀 Página "Como Doar" carregada com sucesso!');
});

/**
 * ===== INICIALIZAÇÃO DE ANIMAÇÕES =====
 */
function initAnimations() {
	// Observer para animações de revelação
	const revealObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('revealed');

				// Iniciar contadores quando a seção de estatísticas for revelada
				if (entry.target.classList.contains('hero-stat-card')) {
					startCounterAnimation(entry.target);
				}
			}
		});
	}, {
		threshold: 0.1,
		rootMargin: '0px 0px -50px 0px'
	});

	// Observar todos os elementos com data-reveal
	document.querySelectorAll('[data-reveal]').forEach(el => {
		revealObserver.observe(el);
	});

	// Animação das estatísticas do hero
	document.querySelectorAll('.hero-stat-card').forEach(card => {
		revealObserver.observe(card);
	});
}

/**
 * ===== TIMELINE INTERATIVA =====
 */
function initTimeline() {
	const timelineSteps = document.querySelectorAll('.timeline-step-premium');
	const timelineFill = document.getElementById('timeline-fill');
	const stepCards = document.querySelectorAll('.step-card-premium');

	let currentStep = 1;

	// Função para atualizar timeline
	function updateTimeline(step) {
		// Atualizar marcadores da timeline
		timelineSteps.forEach((timelineStep, index) => {
			if (index + 1 <= step) {
				timelineStep.classList.add('active');
			} else {
				timelineStep.classList.remove('active');
			}
		});

		// Atualizar preenchimento da timeline
		const percentage = ((step - 1) / (timelineSteps.length - 1)) * 100;
		timelineFill.style.width = percentage + '%';

		// Destacar card correspondente
		stepCards.forEach(card => {
			const cardStep = parseInt(card.getAttribute('data-step'));
			if (cardStep === step) {
				card.style.transform = 'translateY(-15px) scale(1.02)';
				card.style.boxShadow = '0 25px 50px rgba(220, 38, 38, 0.15)';
				card.style.borderColor = 'var(--primary-red)';
			} else {
				card.style.transform = '';
				card.style.boxShadow = '';
				card.style.borderColor = '';
			}
		});
	}

	// Event listeners para os passos da timeline
	timelineSteps.forEach((step, index) => {
		step.addEventListener('click', () => {
			currentStep = index + 1;
			updateTimeline(currentStep);
		});

		step.addEventListener('mouseenter', () => {
			if (!step.classList.contains('active')) {
				step.style.transform = 'scale(1.1)';
			}
		});

		step.addEventListener('mouseleave', () => {
			step.style.transform = '';
		});
	});

	// Event listeners para os cards de passo
	stepCards.forEach(card => {
		card.addEventListener('mouseenter', function() {
			const step = parseInt(this.getAttribute('data-step'));
			updateTimeline(step);
		});

		card.addEventListener('click', function() {
			const step = parseInt(this.getAttribute('data-step'));
			currentStep = step;
			updateTimeline(currentStep);
		});
	});

	// Auto-avanço da timeline (opcional)
	let autoAdvance = setInterval(() => {
		currentStep = currentStep % timelineSteps.length + 1;
		updateTimeline(currentStep);
	}, 4000);

	// Pausar auto-avanço quando o usuário interagir
	document.querySelector('.steps-timeline-premium').addEventListener('mouseenter', () => {
		clearInterval(autoAdvance);
	});
}

/**
 * ===== FAQ INTERATIVO =====
 */
function initFAQ() {
	const faqItems = document.querySelectorAll('.faq-item-premium');

	faqItems.forEach(item => {
		const question = item.querySelector('.faq-question-premium');

		question.addEventListener('click', () => {
			// Fechar outros itens
			faqItems.forEach(otherItem => {
				if (otherItem !== item && otherItem.classList.contains('active')) {
					otherItem.classList.remove('active');
				}
			});

			// Alternar item atual
			item.classList.toggle('active');

			// Animar ícone
			const icon = question.querySelector('i');
			if (item.classList.contains('active')) {
				icon.style.transform = 'rotate(180deg)';
			} else {
				icon.style.transform = 'rotate(0deg)';
			}
		});
	});

	// Abrir primeiro item por padrão
	if (faqItems.length > 0) {
		faqItems[0].classList.add('active');
	}
}

/**
 * ===== CONTADORES ANIMADOS =====
 */
function initCounters() {
	const counters = document.querySelectorAll('[data-count]');

	const counterObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				const counter = entry.target;
				const target = parseInt(counter.getAttribute('data-count'));
				const duration = 2000; // 2 segundos
				const step = target / (duration / 16); // 60fps
				let current = 0;

				const timer = setInterval(() => {
					current += step;
					if (current >= target) {
						current = target;
						clearInterval(timer);
					}
					counter.textContent = Math.floor(current).toLocaleString();
				}, 16);

				counterObserver.unobserve(counter);
			}
		});
	}, { threshold: 0.5 });

	counters.forEach(counter => {
		counterObserver.observe(counter);
	});
}

/**
 * ===== ANIMAÇÃO DOS CONTADORES DAS ESTATÍSTICAS =====
 */
function startCounterAnimation(statCard) {
	const statNumber = statCard.querySelector('.stat-number');
	const target = parseInt(statCard.getAttribute('data-stat'));
	const duration = 1500;
	const step = target / (duration / 16);
	let current = 0;

	const timer = setInterval(() => {
		current += step;
		if (current >= target) {
			current = target;
			clearInterval(timer);
		}
		statNumber.textContent = Math.floor(current).toLocaleString();
	}, 16);
}

/**
 * ===== SCROLL SUAVE =====
 */
function initSmoothScroll() {
	const scrollLinks = document.querySelectorAll('a[href^="#"]');

	scrollLinks.forEach(link => {
		link.addEventListener('click', function(e) {
			e.preventDefault();

			const targetId = this.getAttribute('href');
			if (targetId === '#') return;

			const targetElement = document.querySelector(targetId);
			if (targetElement) {
				const headerHeight = document.getElementById('main-header').offsetHeight;
				const targetPosition = targetElement.offsetTop - headerHeight - 20;

				window.scrollTo({
					top: targetPosition,
					behavior: 'smooth'
				});
			}
		});
	});
}

/**
 * ===== VERIFICAÇÃO DE AUTENTICAÇÃO =====
 */
function initAuthCheck() {
	const authButtons = document.querySelectorAll('.require-auth');

	authButtons.forEach(button => {
		button.addEventListener('click', function(e) {
			const isLoggedIn = checkAuthentication();

			if (!isLoggedIn) {
				e.preventDefault();
				showLoginModal();
			}
		});
	});
}

function checkAuthentication() {
	// Verificar se o usuário está autenticado
	// Esta função deve ser integrada com seu sistema de autenticação
	const token = localStorage.getItem('authToken');
	const user = localStorage.getItem('user');

	return !!(token && user);
}

