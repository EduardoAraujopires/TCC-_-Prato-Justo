document.addEventListener('DOMContentLoaded', function() {
    // Inicializar todas as funcionalidades
    initMobileMenu();
    initAnimations();
    initAuthCheck();
    initSmoothScroll();
    
    console.log('🚀 Página "Como Doar" carregada com sucesso!');
});

/**
 * ===== MENU MOBILE CORRIGIDO =====
 */
function initMobileMenu() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const navMenu = document.getElementById('nav-menu');
    const headerButtons = document.querySelector('.header-buttons-premium');
    
    if (mobileMenuBtn && navMenu) {
        mobileMenuBtn.addEventListener('click', function() {
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            
            // Alternar menu
            this.classList.toggle('active');
            navMenu.classList.toggle('active');
            if (headerButtons) {
                headerButtons.classList.toggle('active');
            }
            
            // Atualizar atributo ARIA
            this.setAttribute('aria-expanded', !isExpanded);
            
            // Animar ícones do hamburger
            const spans = this.querySelectorAll('span');
            if (this.classList.contains('active')) {
                spans[0].style.transform = 'rotate(45deg) translate(6px, 6px)';
                spans[1].style.opacity = '0';
                spans[2].style.transform = 'rotate(-45deg) translate(6px, -6px)';
            } else {
                spans[0].style.transform = 'none';
                spans[1].style.opacity = '1';
                spans[2].style.transform = 'none';
            }
        });
    }
    
    // Fechar menu ao clicar em um link
    document.querySelectorAll('.nav-link-premium').forEach(link => {
        link.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
                mobileMenuBtn.classList.remove('active');
                navMenu.classList.remove('active');
                if (headerButtons) {
                    headerButtons.classList.remove('active');
                }
                
                // Resetar ícones do hamburger
                const spans = mobileMenuBtn.querySelectorAll('span');
                spans[0].style.transform = 'none';
                spans[1].style.opacity = '1';
                spans[2].style.transform = 'none';
                mobileMenuBtn.setAttribute('aria-expanded', 'false');
            }
        });
    });
}

/**
 * ===== ANIMAÇÕES DE REVELAÇÃO =====
 */
function initAnimations() {
    // Observer para animações de revelação
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                
                // Iniciar contadores quando a seção de estatísticas for revelada
                if (entry.target.classList.contains('hero-stat-card')) {
                    startCounterAnimation(entry.target);
                }
            }
        });
    }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    });

    // Observar todos os elementos com data-reveal
    document.querySelectorAll('[data-reveal]').forEach(el => {
        revealObserver.observe(el);
    });

    // Animação das estatísticas do hero
    document.querySelectorAll('.hero-stat-card').forEach(card => {
        revealObserver.observe(card);
    });
}

/**
 * ===== ANIMAÇÃO DOS CONTADORES =====
 */
function startCounterAnimation(statCard) {
    const statNumber = statCard.querySelector('.stat-number');
    const target = parseInt(statCard.getAttribute('data-stat'));
    const duration = 1500;
    const step = target / (duration / 16);
    let current = 0;
    
    const timer = setInterval(() => {
        current += step;
        if (current >= target) {
            current = target;
            clearInterval(timer);
        }
        statNumber.textContent = Math.floor(current).toLocaleString();
    }, 16);
}

/**
 * ===== VERIFICAÇÃO DE AUTENTICAÇÃO =====
 */
function initAuthCheck() {
    const authButtons = document.querySelectorAll('.require-auth');
    
    authButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            const isLoggedIn = checkAuthentication();
            
            if (!isLoggedIn) {
                e.preventDefault();
                showLoginModal();
            }
        });
    });
}

function checkAuthentication() {
    // Verificar se o usuário está autenticado
    // Esta função deve ser integrada com seu sistema de autenticação
    const token = localStorage.getItem('authToken');
    const user = localStorage.getItem('user');
    
    return !!(token && user);
}

