/* ========================================= */
/* CSS PADRONIZADO - COMO DOAR */
/* ========================================= */

:root {
    /* CORES PADRONIZADAS DO PROJETO */
    --primary-red: #dc2626;
    --primary-red-dark: #b91c1c;
    --primary-red-light: #fee2e2;
    --primary-red-rgb: 220, 38, 38;
    
    --secondary-orange: #f59e0b;
    --secondary-orange-dark: #d97706;
    
    --accent-green: #10b981;
    --accent-green-dark: #059669;
    
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --text-white: #ffffff;
    
    --background-light: #f9fafb;
    --background-white: #ffffff;
    --background-dark: #111827;
    
    --border-light: #e5e7eb;
    --border-medium: #d1d5db;
    
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.5rem;
    
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========================================= */
/* RESET E ESTILOS GLOBAIS PADRONIZADOS */
/* ========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: var(--text-dark);
    background: var(--background-light);
}

.container-premium {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* ========================================= */
/* HEADER PADRONIZADO E CORRIGIDO */
/* ========================================= */

.header-premium {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition);
}

.header-container-premium {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

/* Logo */
.logo-premium {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--primary-red);
    transition: var(--transition);
}

.logo-premium:hover {
    transform: scale(1.05);
    color: var(--primary-red-dark);
}

.logo-premium i {
    font-size: 1.75rem;
}

/* Menu de Navegação */
.nav-menu-premium {
    display: flex;
    align-items: center;
}

.nav-links-premium {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
    margin: 0;
    padding: 0;
}

.nav-link-premium {
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-lg);
    transition: var(--transition);
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nav-link-premium:hover {
    color: var(--primary-red);
    background: var(--primary-red-light);
}

.nav-link-premium.active-premium {
    color: var(--primary-red);
    background: var(--primary-red-light);
}

.nav-link-premium.active-premium::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 1.25rem;
    right: 1.25rem;
    height: 2px;
    background: var(--primary-red);
    border-radius: 2px;
}

/* Dropdown */
.dropdown-premium {
    position: relative;
}

.dropdown-toggle-premium {
    position: relative;
}

.notification-badge-premium {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--primary-red);
    color: var(--text-white);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(var(--primary-red-rgb), 0.4);
}

.dropdown-menu-premium {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--background-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 0.5rem;
    min-width: 280px;
    box-shadow: var(--shadow-xl);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: var(--transition);
    z-index: 1000;
}

.dropdown-premium:hover .dropdown-menu-premium {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown-item-premium {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-dark);
    transition: var(--transition);
    border: 1px solid transparent;
}

.dropdown-item-premium:hover {
    background: var(--primary-red-light);
    border-color: rgba(var(--primary-red-rgb), 0.3);
    transform: translateX(5px);
}

.dropdown-item-premium i {
    width: 20px;
    text-align: center;
    color: var(--primary-red);
    font-size: 1.1rem;
}

.item-content-premium {
    flex: 1;
}

.item-title-premium {
    display: block;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
}

.item-desc-premium {
    display: block;
    font-size: 0.8rem;
    color: var(--text-light);
}

.item-status-premium {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 1rem;
}

.item-status-premium.pending-premium {
    background: rgba(var(--primary-red-rgb), 0.2);
    color: var(--primary-red);
}

/* Botões do Header */
.header-buttons-premium {
    display: flex;
    gap: 1rem;
    align-items: center;
}

.btn-premium {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: var(--transition);
    border: 2px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-outline-premium {
    background: transparent;
    color: var(--text-dark);
    border-color: var(--border-medium);
}

.btn-outline-premium:hover {
    background: var(--background-light);
    border-color: var(--text-light);
    transform: translateY(-2px);
}

.btn-primary-premium {
    background: var(--primary-red);
    color: var(--text-white);
    box-shadow: 0 4px 15px rgba(var(--primary-red-rgb), 0.4);
}

.btn-primary-premium:hover {
    background: var(--primary-red-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(var(--primary-red-rgb), 0.6);
}

/* Menu Mobile */
.mobile-menu-btn-premium {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    gap: 4px;
}

.mobile-menu-btn-premium span {
    width: 25px;
    height: 3px;
    background: var(--text-dark);
    border-radius: 2px;
    transition: var(--transition);
}

/* ========================================= */
/* HERO SECTION PADRONIZADA */
/* ========================================= */

.como-doar-hero-premium {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 50%, var(--primary-red-dark) 100%);
    overflow: hidden;
    margin-top: 0;
}

.hero-background-premium {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.floating-food-icons {
    position: absolute;
    width: 100%;
    height: 100%;
}

.floating-food-icons i {
    position: absolute;
    font-size: 2rem;
    opacity: 0.2;
    animation: floatFood 15s infinite linear;
    color: rgba(255, 255, 255, 0.6);
}

.floating-food-icons i:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; }
.floating-food-icons i:nth-child(2) { top: 20%; right: 10%; animation-delay: 2s; }
.floating-food-icons i:nth-child(3) { top: 60%; left: 15%; animation-delay: 4s; }
.floating-food-icons i:nth-child(4) { top: 40%; right: 20%; animation-delay: 6s; }
.floating-food-icons i:nth-child(5) { bottom: 20%; left: 10%; animation-delay: 8s; }
.floating-food-icons i:nth-child(6) { bottom: 30%; right: 15%; animation-delay: 10s; }

@keyframes floatFood {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 0.3; }
    90% { opacity: 0.3; }
    100% { transform: translateY(-100px) rotate(360deg); opacity: 0; }
}

.hero-content-wrapper-premium {
    position: relative;
    z-index: 2;
    text-align: center;
    color: var(--text-white);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

.impact-badge-premium {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--accent-green), var(--primary-red));
    padding: 0.75rem 2rem;
    border-radius: var(--radius-2xl);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(var(--primary-red-rgb), 0.4);
    animation: pulse-badge 2s infinite;
}

@keyframes pulse-badge {
    0%, 100% { box-shadow: 0 10px 30px rgba(var(--primary-red-rgb), 0.4); }
    50% { box-shadow: 0 10px 40px rgba(var(--primary-red-rgb), 0.8); }
}

.hero-title-premium {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.5);
}

.hero-title-premium .highlight-premium {
    background: linear-gradient(135deg, var(--secondary-orange), var(--primary-red));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle-premium {
    font-size: 1.4rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.95;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.hero-subtitle-premium strong {
    color: var(--secondary-orange);
    font-weight: 700;
}

/* Estatísticas do Hero */
.hero-stats-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin: 4rem auto;
    max-width: 1000px;
}

.hero-stat-card {
    background: rgba(255, 255, 255, 0.1);
    padding: 2.5rem 2rem;
    border-radius: var(--radius-2xl);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.hero-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: var(--transition-slow);
}

.hero-stat-card:hover::before {
    left: 100%;
}

.hero-stat-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    border-color: rgba(251, 191, 36, 0.5);
}

.stat-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--secondary-orange), var(--primary-red));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2rem;
    color: var(--text-white);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
}

.stat-number {
    font-size: 3.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, #fff, var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    line-height: 1;
}

.stat-label {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--secondary-orange);
}

.stat-description {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.4;
}

/* CTA Hero */
.hero-cta-premium {
    max-width: 800px;
    margin: 3rem auto 0;
}

.cta-message-premium {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(16, 185, 129, 0.2);
    padding: 1.5rem 2rem;
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--accent-green);
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
}

.cta-message-premium i {
    color: var(--accent-green);
    font-size: 1.5rem;
}

.cta-message-premium strong {
    color: var(--accent-green);
}

.cta-buttons-hero {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-hero-primary {
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    color: var(--text-white);
    padding: 1.25rem 2.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    box-shadow: 0 10px 30px rgba(var(--primary-red-rgb), 0.4);
    border: none;
    cursor: pointer;
}

.btn-hero-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(var(--primary-red-rgb), 0.6);
}

.btn-hero-secondary {
    background: transparent;
    color: var(--text-white);
    padding: 1.25rem 2.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    border: 2px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
}

.btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-3px);
}

/* Scroll Indicator */
.scroll-indicator-premium {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    text-align: center;
}

.scroll-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.scroll-arrow {
    width: 30px;
    height: 30px;
    border-right: 3px solid rgba(255, 255, 255, 0.7);
    border-bottom: 3px solid rgba(255, 255, 255, 0.7);
    transform: rotate(45deg);
    animation: bounce 2s infinite;
    margin: 0 auto;
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: rotate(45deg) translateY(0); }
    40% { transform: rotate(45deg) translateY(-10px); }
    60% { transform: rotate(45deg) translateY(-5px); }
}

/* ========================================= */
/* SEÇÃO EMPATIA PADRONIZADA */
/* ========================================= */

.empathy-section-premium {
    padding: 6rem 0;
    background: linear-gradient(135deg, var(--primary-red), var(--primary-red-dark));
    color: var(--text-white);
    position: relative;
    overflow: hidden;
}

.empathy-container-premium {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
}

.empathy-badge-premium {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.75rem 2rem;
    border-radius: var(--radius-2xl);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
}

.empathy-title-premium {
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: 1.5rem;
}

.empathy-quote-premium {
    font-size: 1.3rem;
    font-style: italic;
    margin-bottom: 3rem;
    opacity: 0.9;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.empathy-cards-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.empathy-card-premium {
    background: rgba(255, 255, 255, 0.1);
    padding: 2.5rem 2rem;
    border-radius: var(--radius-2xl);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: var(--transition);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.empathy-card-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: var(--transition-slow);
}

.empathy-card-premium:hover::before {
    left: 100%;
}

.empathy-card-premium:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.empathy-icon-premium {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--accent-green), var(--primary-red));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2rem;
    color: var(--text-white);
}

.empathy-card-premium h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--secondary-orange);
}

.empathy-card-premium p {
    opacity: 0.9;
    line-height: 1.6;
}

/* ========================================= */
/* SEÇÃO PASSOS PADRONIZADA */
/* ========================================= */

.donation-steps-premium {
    padding: 6rem 0;
    background: var(--background-light);
}

.section-header-premium {
    text-align: center;
    margin-bottom: 4rem;
}

.section-badge-premium {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    padding: 0.75rem 2rem;
    border-radius: var(--radius-2xl);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 1rem;
    color: var(--text-white);
}

.section-header-premium h2 {
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.highlight-text {
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.section-header-premium p {
    font-size: 1.125rem;
    color: var(--text-light);
    max-width: 600px;
    margin: 0 auto;
}

.steps-container-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.step-card-premium {
    background: var(--background-white);
    padding: 2.5rem;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
    text-align: center;
    transition: var(--transition);
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    cursor: pointer;
}

.step-card-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--primary-red-light), transparent);
    transition: var(--transition-slow);
}

.step-card-premium:hover::before {
    left: 100%;
}

.step-card-premium:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-red);
}

.step-number-premium {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    color: var(--text-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.25rem;
    box-shadow: var(--shadow-lg);
    z-index: 2;
}

.step-icon-premium {
    width: 90px;
    height: 90px;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem auto 1.5rem;
    font-size: 2.5rem;
    color: var(--text-white);
    transition: var(--transition);
}

.step-card-premium:hover .step-icon-premium {
    transform: scale(1.1) rotate(5deg);
}

.step-card-premium h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-dark);
}

.step-card-premium p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.step-features-premium {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
}

.step-features-premium span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dark);
    font-size: 0.9rem;
}

.step-features-premium i {
    color: var(--primary-red);
    font-size: 0.875rem;
}

.step-tip-premium {
    background: var(--primary-red-light);
    padding: 1rem;
    border-radius: var(--radius-lg);
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--primary-red-dark);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* ========================================= */
/* SEÇÃO TIPOS DE ALIMENTOS PADRONIZADA */
/* ========================================= */

.food-types-premium {
    padding: 6rem 0;
    background: var(--background-white);
}

.food-grid-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
}

.food-card-premium {
    background: var(--background-white);
    padding: 2.5rem 2rem;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
    text-align: center;
    transition: var(--transition);
    border: 2px solid var(--border-light);
    position: relative;
    overflow: hidden;
}

.food-card-premium:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-red);
}

.food-icon-premium {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-orange));
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2rem;
    color: var(--text-white);
    transition: var(--transition);
}

.food-card-premium:hover .food-icon-premium {
    transform: scale(1.1) rotate(-5deg);
}

.food-card-premium h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-dark);
}

.food-card-premium p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.food-examples-premium {
    list-style: none;
    text-align: left;
    margin-bottom: 1.5rem;
}

.food-examples-premium li {
    padding: 0.5rem 0;
    color: var(--text-dark);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
}

.food-examples-premium i {
    color: var(--accent-green);
    font-size: 0.8rem;
}

.food-status-premium {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-green);
    color: var(--text-white);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-2xl);
    font-size: 0.8rem;
    font-weight: 600;
}

.food-status-premium.available {
    background: var(--accent-green);
}

/* Alerta de Qualidade */
.quality-alert-premium {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: var(--primary-red-light);
    padding: 2rem;
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--primary-red);
    max-width: 800px;
    margin: 0 auto;
}

.alert-icon-premium {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    background: var(--primary-red);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-white);
}

.alert-content-premium h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-dark);
}

.alert-content-premium p {
    color: var(--text-light);
    line-height: 1.6;
    margin: 0;
}

/* ========================================= */
/* SEÇÃO CTA FINAL PADRONIZADA */
/* ========================================= */

.cta-final-premium {
    padding: 6rem 0;
    background: linear-gradient(135deg, var(--primary-red) 0%, var(--primary-red-dark) 50%, var(--secondary-orange) 100%);
    color: var(--text-white);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.cta-final-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 70% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
}

.cta-content-premium {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
}

.cta-badge-premium {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.75rem 2rem;
    border-radius: var(--radius-2xl);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
}

.cta-content-premium h2 {
    font-size: 3rem;
    font-weight: 900;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
}

.cta-description-premium {
    font-size: 1.25rem;
    opacity: 0.95;
    margin-bottom: 3rem;
    line-height: 1.7;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.cta-buttons-final-premium {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-final-primary {
    background: linear-gradient(135deg, var(--accent-green), var(--primary-red));
    color: var(--text-white);
    padding: 1.25rem 2.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    box-shadow: 0 10px 30px rgba(var(--primary-red-rgb), 0.4);
}

.btn-final-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(var(--primary-red-rgb), 0.6);
}

.btn-final-secondary {
    background: transparent;
    color: var(--text-white);
    padding: 1.25rem 2.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    border: 2px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
}

.btn-final-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-3px);
}

/* ========================================= */
/* FOOTER PADRONIZADO */
/* ========================================= */

.footer-premium {
    background: var(--background-dark);
    color: var(--text-white);
    padding: 4rem 0 2rem;
}

.footer-content-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
}

.footer-section-premium h4 {
    color: var(--text-white);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
}

.footer-section-premium ul {
    list-style: none;
}

.footer-section-premium ul li {
    margin-bottom: 0.75rem;
}

.footer-section-premium ul li a {
    color: var(--text-light);
    text-decoration: none;
    transition: var(--transition);
}

.footer-section-premium ul li a:hover {
    color: var(--primary-red);
}

.footer-logo-premium {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.footer-logo-premium i {
    font-size: 2rem;
    color: var(--primary-red);
}

.footer-logo-premium h3 {
    color: var(--text-white);
    font-size: 1.5rem;
}

.social-links-premium {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
}

.social-link-premium {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: var(--text-white);
    text-decoration: none;
    transition: var(--transition);
}

.social-link-premium:hover {
    background: var(--primary-red);
    transform: translateY(-2px);
}

.contact-info-premium p {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--text-light);
}

.footer-bottom-premium {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.footer-links-premium {
    display: flex;
    gap: 2rem;
}

.footer-links-premium a {
    color: var(--text-light);
    text-decoration: none;
    transition: var(--transition);
}

.footer-links-premium a:hover {
    color: var(--primary-red);
}

/* ========================================= */
/* ANIMAÇÕES E RESPONSIVIDADE */
/* ========================================= */

[data-reveal] {
    opacity: 0;
    transform: translateY(50px);
    transition: var(--transition-slow);
}

[data-reveal].revealed {
    opacity: 1;
    transform: translateY(0);
}

/* Responsividade */
@media (max-width: 768px) {
    .header-container-premium {
        padding: 1rem;
    }

    .nav-menu-premium {
        display: none;
    }

    .header-buttons-premium {
        display: none;
    }

    .mobile-menu-btn-premium {
        display: flex;
    }

    /* Menu mobile aberto */
    .nav-menu-premium.active {
        display: flex;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--background-white);
        flex-direction: column;
        padding: 1rem;
        box-shadow: var(--shadow-lg);
        border-top: 1px solid var(--border-light);
    }

    .nav-links-premium {
        flex-direction: column;
        width: 100%;
        gap: 0.5rem;
    }

    .nav-link-premium {
        width: 100%;
        justify-content: center;
        padding: 1rem;
    }

    .header-buttons-premium.active {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .header-buttons-premium.active .btn-premium {
        width: 100%;
        justify-content: center;
    }

    .hero-title-premium {
        font-size: 2.5rem;
    }

    .hero-subtitle-premium {
        font-size: 1.2rem;
    }

    .hero-stats-premium {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .steps-container-premium {
        grid-template-columns: 1fr;
    }

    .food-grid-premium {
        grid-template-columns: 1fr;
    }

    .cta-content-premium h2 {
        font-size: 2rem;
    }

    .cta-buttons-hero,
    .cta-buttons-final-premium {
        flex-direction: column;
        align-items: stretch;
    }

    .section-header-premium h2 {
        font-size: 2rem;
    }

    .empathy-cards-premium {
        grid-template-columns: 1fr;
    }

    .quality-alert-premium {
        flex-direction: column;
        text-align: center;
    }

    .footer-content-premium {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .footer-bottom-premium {
        flex-direction: column;
        text-align: center;
    }

    .footer-links-premium {
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .como-doar-hero-premium {
        min-height: 90vh;
        padding: 5rem 0 3rem;
    }

    .hero-title-premium {
        font-size: 2rem;
    }

    .step-card-premium,
    .food-card-premium {
        padding: 2rem 1.5rem;
    }

    .step-number-premium {
        width: 40px;
        height: 40px;
        font-size: 1rem;
        top: -15px;
    }

    .container-premium {
        padding: 0 1rem;
    }
}